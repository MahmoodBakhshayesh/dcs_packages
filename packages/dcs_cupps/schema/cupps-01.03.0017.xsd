  <xs:simpleType name="bcTypeCodeT">
    <xs:annotation>
      <xs:documentation>
        Barcode type codes per the AEA manual.
        Note AEA defines horizontal and vertical orientations
        for barcode printing.  Since orientation
        has no meaning when reading barcodes, these codes
        are based on the horizontal codes.  Only those codes
        in the vertical table that have no equivalent in
        the horizontal table are included.  The list below
        shows any cross-reference between the horizontal
        and vertical codes from the AEA spec.

        1=S => 1D Code Interleaved 2 of 5
        2=T => 1D Code Industrial 2 of 5
        3=U => 1D Code 39
        4=  => 2D Data Matrix (This was Code 128)
        5=  => QR
        6=R => 2D PDF417
        7=W => 1D Code 128 with check digit
        8=X => 1D Code 39 with check digit
        9=Y => 1D Industrial 2 of 5 with check digit
        0=Z => 1D Interleaved 2 of 5 with check digit
        A=P => EAN 13 with check digit (check digit must be supplied by TE or Host)
        V   => 2d Aztec
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="1">
        <xs:annotation>
          <xs:documentation>
            1=S => 1D Code Interleaved 2 of 5
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="2">
        <xs:annotation>
          <xs:documentation>
            2=T => 1D Code Industrial 2 of 5
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="3">
        <xs:annotation>
          <xs:documentation>
            3=U => 1D Code 39
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="4">
        <xs:annotation>
          <xs:documentation>
            4=  => 2D Data Matrix (This was Code 128)
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="5">
        <xs:annotation>
          <xs:documentation>
            5=  => QR
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="6">
        <xs:annotation>
          <xs:documentation>
            6=R => 2D PDF417
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="7">
        <xs:annotation>
          <xs:documentation>
            7=W => 1D Code 128 with check digit
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="8">
        <xs:annotation>
          <xs:documentation>
            8=X => 1D Code 39 with check digit
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="9">
        <xs:annotation>
          <xs:documentation>
            9=Y => 1D Industrial 2 of 5 with check digit
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="0">
        <xs:annotation>
          <xs:documentation>
            0=Z => 1D Interleaved 2 of 5 with check digit
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="A">
        <xs:annotation>
          <xs:documentation>
            A=P => EAN 13 with check digit (check digit must be supplied by TE or Host)
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="V">
        <xs:annotation>
          <xs:documentation>
            V   => 2d Aztec
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>


