  <!-- ************************* -->
  <!-- ************************* -->

  
  <xs:complexType name="supportedStocksT">
    <xs:annotation>
      <xs:documentation>
        Wraps the sequence of stocks supported
        on the printer.
        Requires at least one supported stock,
        otherwise the printer is just a decoration.
        Is needed for PR, optional for BT and BP
      </xs:documentation>
    </xs:annotation>
    <xs:sequence minOccurs="1"
                 maxOccurs="unbounded">
      <xs:element name="supportedStock"
                  type="supportedStockT"/>
    </xs:sequence>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->

  
  <xs:complexType name="supportedStockT">
    <xs:annotation>
      <xs:documentation>
        Details of a stock supported by a printer.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="stockName"
                  type="stockNameT"
                  use="required"/>
    <xs:attribute name="supportsColor"
                  type="colorSupportT"
                  use="required"/>
    <xs:attribute name="stockWidth"
                  type="stockDimensionHWT"
                  use="required"/>
    <xs:attribute name="stockHeight"
                  type="stockDimensionHWT"
                  use="required"/>
    <xs:attribute name="leftMargin"
                  type="stockDimensionT"
                  use="required"/>
    <xs:attribute name="rightMargin"
                  type="stockDimensionT"
                  use="required"/>
    <xs:attribute name="topMargin"
                  type="stockDimensionT"
                  use="required"/>
    <xs:attribute name="bottomMargin"
                  type="stockDimensionT"
                  use="required"/>
    <xs:attribute name="perforationLeft"
                  type="stockDimensionT"
                  use="required"/>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->

  
  <xs:complexType name="svgPrintDocumentT">
    <xs:annotation >
      <xs:documentation >
        SVG print document
        Print document is completely encoded
        in an SVG graphic.
        Binary data is encoded as Basea64 per
        RFC3548.
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent>
      <xs:extension  base="xs:base64Binary"/>
    </xs:simpleContent>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->

  
  <xs:complexType name="vendorModelInfoT">
    <xs:annotation>
      <xs:documentation>
        Wrapper for the vendor and model of a device.
        May include misc. information about the device.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="vendor"
                  type="vendorT"
                  use="required"/>
    <xs:attribute name="model"
                  type="modelT"
                  use="required"/>
    <xs:attribute name="miscInfo"
                  type="noteT"
                  use="optional"/>
