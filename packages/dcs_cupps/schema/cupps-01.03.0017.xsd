  <!-- ************************* -->
  <!-- ************************* -->


  <xs:complexType name="deviceAcquireRequestT">
    <xs:annotation >
      <xs:documentation >
        Application acquisition of a device.  After
        an application successfulocally authenticates
        with the platform, the client opens a connection
        to each device that it will use.  The client
        must provide the name of the device to open.
        If the name is invalid, the request will be
        rejected.  The client must provide a valid
        token or the request will be rejected.
        Note that the attribute msFoidMasking only applies to MS devices, all
        other devices will get result "invalidFoidMasking".
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="deviceToken"
                  type="tokenT"
                  use="required"/>
    <xs:attribute name="deviceName"
                  type="deviceNameT"
                  use="required"/>
    <xs:attribute name="airlineID"
                  type="airlineIDTwoT"
                  use="required"/>
    <xs:attribute name="msFoidMasking"
                  type="msFoidMaskingT"
                  use="optional"/>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->


  <xs:complexType name="deviceAcquireResponseT">
    <xs:annotation >
      <xs:documentation >
        Device Acquire Response
        If the device acquire is successful, the
        platform returns to the client parameters
        related to the device.  These parameters may
        indicate operations aspects, information
        suitable for logging, or other information.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence minOccurs="0"
                 maxOccurs="1">
      <xs:annotation>
        <xs:documentation>
          Allow zero devices to be returned in case
          of an error.
        </xs:documentation>
      </xs:annotation>
      <xs:element name="device"
                  type="deviceT"/>
    </xs:sequence>
    <xs:attribute name="result"
                  type="deviceAcquireRRT"
                  use="required"/>
  </xs:complexType>


