    <xs:annotation >
      <xs:documentation >
        filter:
        0.*.*.*
        224.*.*.* and above
        leading and trailing garbage

        accept:
        0-pading to 3 digits, i.e. 001 is accepted but not 01,
        000 as leading byte is treated as 0 and rejected
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern
value="([1-9]|00[1-9]|0?[1-9][0-9]|1[0-9][0-9]|2[0-1][0-9]|22[0-3])\.([0-9]|00[0-9]|0?[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\.([0-9]|00[0-9]|0?[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])\.([0-9]|00[0-9]|0?[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])"/>
