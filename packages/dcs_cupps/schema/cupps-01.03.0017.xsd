  <xs:complexType name="printRequestDocumentT">
    <xs:annotation >
      <xs:documentation >
        Print Request Document
        This type is a wrapper for the various
        formats that are accetpable by the platform.
        Each of these elements has one child that
        contains the print document and an attribute
        that gives each document a unique ID.
        Print documents may be given as:
        - simple text: ASCII text and CR/LR line seps
        - HTML: complete HTML rendering of the doc
        - SVG, BMP, PDF: Graphic formats that have
        already been rendered by the client into
        their final form.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="1"
               maxOccurs="1">
      <xs:element name="simpleTextPrintDocument"
                  type="simpleTextPrintDocumentT"/>
      <xs:element name="bmpPrintDocument"
                  type="bmpPrintDocumentT"/>
      <xs:element name="svgPrintDocument"
                  type="svgPrintDocumentT"/>
      <xs:element name="htmlPrintDocument"
                  type="htmlPrintDocumentT"/>
      <xs:element name="pdfPrintDocument"
                  type="pdfPrintDocumentT"/>
      <xs:element name="downloadObjectPrintDocument"
                  type="downloadObjectPrintDocumentT"/>
    </xs:choice>
    <xs:attribute name="documentID"
                  type="documentIDT"
                  use="required"/>
    <xs:attribute name="rotation"
                  type="rotationT"
                  use="optional"/>
    <!--<xs:attribute name="documentOrientation"
                  type="printDocumentOrientationT"
                  use="optional"/>-->
    <xs:attribute name="rfidTagNum"
                  type="rfidTagNumberT"
                  use="optional"/>
    <xs:attribute name="stockName"
                  type="stockNameT"
                  use="required"/>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->

  
  <xs:complexType name="printRequestT">
    <xs:annotation >
      <xs:documentation >
        Print Request
        Wrapper for a complete print request.  Each
        print request may contain one-or-more documents
        to print.  Each individual print document may
        given in any supported print format (simple text,
        PDF, etc).
        <!--This wrapper provides for the concept of a print
        job, where the job is a logical unit of work.  For
        example, if a client needs to issue boarding
        pass documents for a family of four, assuming each
        passenger receives his own document, then a single
        print request may be used to wrap the four
        documents.-->
      </xs:documentation>
    </xs:annotation>
    <xs:sequence >
      <xs:sequence maxOccurs="unbounded">
        <xs:element name="printDocument"
                    type="printRequestDocumentT"/>
      </xs:sequence>
    </xs:sequence>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->

  
  <xs:complexType name="printResponseT">
    <xs:annotation >
      <xs:documentation >
        Print Response
        Provides a wrapper for the results of
        print set.  The wrapper provides a summary
        response, indicating if any of the child
        print documents failed, or if they were
        all successful.  If the status indicates that
        all were successful, there is no need to
        examine each child documents status.  If the
        status indicates that one or more children
        have issues, then the client should examine
        the status of each print document.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence maxOccurs="unbounded">
      <xs:element name="printDocumentResult"
                  type="printDocumentResultT"/>
    </xs:sequence>
    <xs:attribute name="result"
                  type="printRRT"/>
  </xs:complexType>


