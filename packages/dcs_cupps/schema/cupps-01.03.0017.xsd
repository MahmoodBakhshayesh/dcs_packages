    <xs:restriction base="xs:string">
      <xs:pattern value="[!&quot;#$%&amp;&apos;\(\)\*\+,\-\./0123456789:;&lt;=&gt;\?@ABCDEFGHIJKLMNOPQRSTUVWXYZ\[\]\^_`abcdefghijklmnopqrstuvwxyz\{\|\}~]{16}"/>
