    <xs:sequence>
      <xs:element name="bcStatus"
                  type="bcStatusT">
        <xs:annotation>
          <xs:documentation>
            Status of required sub-device BC.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="ddStatus"
                  type="ddStatusT">
