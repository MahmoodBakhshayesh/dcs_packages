    <xs:sequence minOccurs="1"
                 maxOccurs="1">
      <xs:element name="ipAndPort"
                  type="ipAndPortT"/>
      <xs:element name="applicationList"
                  type="applicationListT"/>
    </xs:sequence>
    <xs:attribute name="lockMethod"
                  type="lockMethodT"
                  use="required"/>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->


  <xs:complexType name="deviceLockRequestT">
    <xs:annotation >
      <xs:documentation >
        Application request to lock a device
        for exclusive access to a device.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="lockMethod"
                  type="lockMethodT"
                  use="required"/>
    <xs:attribute name="renew"
                  type="lockRenewFlagT"
                  use="optional"/>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->


  <xs:complexType name="deviceLockResponseT">
    <xs:annotation >
      <xs:documentation >
        Platforms response to clients request for
        exclusive access to a device.
        If this device is already locked by another
        client, then the lock request is denied.
        If this device is not already locked by
        another client, the lock request is granted.
        If a client requests a lock for a device where
        the client already has a lock, the request is
        granted.
        Locks issued by the platform expire after a
        certain period.  For clients that desire to
        retain a lock over a longer period of time,
        the client must periodically reissue the lock
        request.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence minOccurs="0">
      <xs:element name="deviceLockerInfo"
                  type="deviceLockerInfoT"/>
    </xs:sequence>
    <xs:attribute name="result"
                  type="deviceLockRRT"
                  use="required"/>
  </xs:complexType>


