                  use="required"/>
    <xs:attribute name="user"
                  type="userNameT"
                  use="optional"/>
    <xs:attribute name="applicationName"
                  type="applicationNameT"
                  use="optional"/>
    <xs:attribute name="applicationVersion"
                  type="applicationVersionT"
                  use="optional"/>
    <xs:attribute name="device"
                  type="deviceNameT"
                  use="optional"/>
    <xs:attribute name="errorType"
                  type="messageIDErrorTypeT"
                  use="required"/>
  </xs:complexType>


