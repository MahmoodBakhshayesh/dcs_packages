                  type="applicationListT"/>
    </xs:sequence>
    <xs:attribute name="airline"
                  type="airlineIDTwoT"
                  use="required"/>
    <xs:attribute name="eventToken"
                  type="tokenT"
                  use="required">
      <xs:annotation>
        <xs:documentation>
          Token used for matching of event subscriptions
          to events caused by this application.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="platformDefinedParameter"
                  type="platformDefinedParameterT"
                  use="optional">
      <xs:annotation >
        <xs:documentation >
          Optional
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->


  <xs:complexType name="authenticateResponseT">
    <xs:annotation >
      <xs:documentation >
        Authentication Response Type
        If a client successfulocally authenticates, the
        client is issued a token to be used for
        device related messages. Device messages
        without a valid token will be rejected.
        If a clients connection to the platform is
        broken, the platform will invalidate the
        token. Therefore, the client must be
        prepared to terminate all of its connections,
        and re-issue the authenticate request.
        This will obtain a new token, which may be
        used to open device connections.
      </xs:documentation>
    </xs:annotation>
    <xs:choice minOccurs="0" >
      <xs:sequence >
        <xs:element name="platformParameter"
                    type="platformParameterT"/>
        <xs:element name="applicationParameter"
                    type="applicationParameterT">
          <xs:unique name="authenticateRsp-applicationParameter-storageT">
            <xs:selector xpath="./ns:storage"/>
            <xs:field xpath="@storageT">
            </xs:field>
          </xs:unique>
        </xs:element>
        <xs:element name="workstationParameter"
                    type="workstationParameterT"/>
        <xs:element name="deviceList" type="deviceListT">
          <xs:unique name="authenticateRsp-devicelist-devicename">
            <xs:selector xpath="./ns:device|./ns:device/ns:device|./ns:device/ns:device/ns:device"/>
            <xs:field xpath="@deviceName" />
          </xs:unique>
        </xs:element>
      </xs:sequence>
      <xs:element name="redirect"
                  type="redirectRequestT"/>
    </xs:choice>
    <xs:attribute name="result"
                  type="authenticateRRT"
                  use="required"/>
    <xs:attribute name="deviceToken"
                  type="tokenT"
                  use="required"/>
  </xs:complexType>


