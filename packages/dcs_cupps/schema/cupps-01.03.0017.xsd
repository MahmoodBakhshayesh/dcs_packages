  <xs:simpleType name="storageTypeT">
    <xs:annotation >
      <xs:documentation >
        Storage type indicates what type and the location
        for storage. Three types are required:
        (1) persistent local --
        local workstation,
        not backed up,
        private to the workstation
        (2) persistent global --
        globally accessible,
        backed up
        (3) transient --
        may be local or on network,
        not backed up,
        private to the workstation

        note: in the case of a then client, there may
        not be truely local storage.  In that case, it
        refers to the server-side storage that is part
        of the thin client VM.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="persistentLocal"/>
      <xs:enumeration value="persistentGlobal"/>
      <xs:enumeration value="transient"/>
    </xs:restriction>
  </xs:simpleType>


