  <xs:simpleType name="absoluteFilenameT">
    <xs:annotation>
      <xs:documentation>
        Represents an absolute path and name of a file
        Must be in this format: (a) a single letter for the drive
        (b) a colon, (c) a forward slash, (d) one to 255 characters
        of a valid Windows file name (note: Windows does these
        characters in a file name: bashslash, forward slash,
        colon, asterisk, question mark, double quotation mark,
        less than, greater than, pipe), (e) .XSD

        ex: C:/SITA/APC/CUPPS/XSD/01.00/cupps-01.00.xsd
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwyxz]:/[/\+,\-\.0123456789:;=@ABCDEFGHIJKLMNOPQRSTUVWXYZ\[\]\^_`abcdefghijklmnopqrstuvwxyz\{\}~]([/\+,\-\.0123456789:;=@ABCDEFGHIJKLMNOPQRSTUVWXYZ\[\]\^_`abcdefghijklmnopqrstuvwxyz \{\}~]{0,255}).(xsd|XSD)"/>
    </xs:restriction>
  </xs:simpleType>

  
  <!-- ************************* -->
  <!-- ************************* -->

  <xs:simpleType name="aeaRequestResultT">
    <xs:annotation>
      <xs:documentation>
         The aeaResponse serves both as a WriteACK when sent by the platform
         as well as a ReadACK when sent by the application. As AEA applications
         have a need to know if their data was sucessfully delivered to the device,
         any write Error that the platform encounters when writing to any AEA
         device needs to be communicated back to the application as writeError.
         Result notAuthorized is for blocking stuff like KP and PD.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="OK"/>
      <xs:enumeration value="writeError"/>
      <xs:enumeration value="notAuthorized"/>
    </xs:restriction>
  </xs:simpleType>

  
  <!-- ************************* -->
  <!-- ************************* -->

  
  <xs:simpleType name="airlineIDTwoT">
    <xs:annotation >
      <xs:documentation >
        IATA ID-2 IDs for als. Since the list is
        very long, it is not practical to enumerate its
        values. A pattern is used, allowing any 2-char
        string.
        If invalid values becomes a problem in the future,
        then the list can be enumerated.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Z0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  
