  <xs:complexType name="simpleTextPrintDocumentNodeT">
    <xs:annotation>
      <xs:documentation>
        A text print document may be composed of a series
        of text and binary nodes.  (a) If the document does not
        contain any non-printable characters (i.e. printer commands),
        the the print document may be specified in base64 or as
        plain text.  (b) If the document does contains non-printable
        characters, then at least those portions of the print document
        must be delivered in base64.  If desired, an application may
        choose to break up the document into chuncks of plain-text and
        base64.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence minOccurs="1"
                 maxOccurs="unbounded">
      <xs:choice>
        <xs:element name="simpleTextPrintDocumentTextNode"
                    type="simpleTextPrintDocumentTextNodeT"
                    minOccurs="0"/>
        <xs:element name="simpleTextPrintDocumentBinaryNode"
                    type="simpleTextPrintDocumentBinaryNodeT"
                    minOccurs="0"/>
      </xs:choice>
    </xs:sequence>
  </xs:complexType>


