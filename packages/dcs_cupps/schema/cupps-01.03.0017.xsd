  <!-- ************************* -->


  <xs:complexType name="logOpenRequestT">
    <xs:annotation >
      <xs:documentation >
        Opens a log for writing.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="scope"
                  type="logOpenRequestScopeT"
                  use="required"/>
    <xs:attribute name="securityToken"
                  type="tokenT"
                  use="required"/>
    <xs:attribute name="logID"
                  type="logIDT"
                  use="required"/>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->


  <xs:complexType name="logOpenResponseT">
    <xs:annotation >
      <xs:documentation >
        Result of attempting to open a log.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="result"
                  type="logOpenRRT"
                  use="required"/>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->


  <xs:complexType name="logRetrieveRequestT">
    <xs:annotation >
      <xs:documentation >
        Request of retrieve records from a log.
        The log must have been previously
        opened.
      </xs:documentation>
    </xs:annotation>
    <xs:attribute name="logID"
                  type="logIDT"
                  use="required"/>
    <xs:attribute name="securityToken"
                  type="tokenT"
                  use="required"/>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->


  <xs:complexType name="logRetrieveResponseT">
    <xs:annotation >
      <xs:documentation >
        Result of attempting to retrieve records
        from a log.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence minOccurs="0"
                 maxOccurs="unbounded">
      <xs:element name="logMessage"
                  type="logMessageT"/>
    </xs:sequence>
    <xs:attribute name="result"
                  type="logRetrieveRRT"
                  use="required"/>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->


  <xs:complexType name="logWriteRequestT">
    <xs:annotation >
      <xs:documentation >
        Attempt to write log entries to an
        open log.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence maxOccurs="unbounded">
      <xs:element name="logMessage"
                  type="logMessageT"/>
    </xs:sequence>
    <xs:attribute name="logID"
                  type="logIDT"
                  use="required"/>
    <xs:attribute name="sync"
              type="xs:boolean"
              use="optional">
      <xs:annotation>
        <xs:documentation>
          If sync is true, the log entry is
          written before the request completes.
          If sync is false, the log entry
          write request is queued and the call
          returns.  The log write completes async.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->


  <xs:complexType name="logWriteResponseT">
    <xs:annotation>
      <xs:documentation>
        Result of attempt to write to a log.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence maxOccurs="unbounded">
      <xs:element name="logMessageResult"
                  type="logMessageResultT"/>
    </xs:sequence>
    <xs:attribute name="result"
                  type="logWriteRRT"
                  use="required"/>
  </xs:complexType>


