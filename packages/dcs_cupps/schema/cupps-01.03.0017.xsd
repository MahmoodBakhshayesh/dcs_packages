  <xs:complexType name="cuppsT">
    <xs:annotation>
      <xs:documentation>
        Wrapper for CUPPS element, which serves
        as the standard wrapper for all CUPPS
        interface messages.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence minOccurs="1"
                 maxOccurs="1">
      <xs:choice >
        <xs:annotation>
          <xs:documentation>
            A CUPPS message may have exactly one
            request, response, or notification.
            Multiple CUPPS messages are never
            sent in a single message.
          </xs:documentation>
        </xs:annotation>
        <xs:group ref="requestGroup"/>
        <xs:group ref="responseGroup"/>
        <xs:group ref="notificationGroup"/>
      </xs:choice>
      <xs:sequence minOccurs="0"
                   maxOccurs="1">
        <xs:element name="relayTo"
                    type="ipAndPortT"/>
      </xs:sequence>
    </xs:sequence>
    <xs:attribute name="messageName"
                  type="messageNameT"
                  use="required"/>
    <xs:attribute name="messageID"
                  type="messageIDT"
                  use="required"/>
  </xs:complexType>


