  <xs:simpleType name="deviceLockRRXT">
    <xs:annotation >
      <xs:documentation >
        Device Lock Request
        Result Type
        Results of attempt to lock a device.
        Locking will fail if another application already
        has a lock.  Apps cannot block their
        own attempts to lock.
      </xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="deviceLocked">
        <xs:annotation >
          <xs:documentation >
            The provided token is invalid.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="OK-deviceAlreadyLocked">
        <xs:annotation>
          <xs:documentation>
            The application already had the device locked.
            The timer associated with the lock is reset.
          </xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="switchingLockMethodsNotAllowed">
        <xs:annotation>
          <xs:documentation>
            The application already holds a byDeviceToken lock and
            has requested a byConnection lock, or vice-versa.
            Unlock the device first, then request the other
            method.
          </xs:documentation>
        </xs:annotation>
