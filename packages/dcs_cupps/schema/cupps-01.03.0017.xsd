    <xs:attribute name="logEntryID"
                  type="logMessageIDT"
                  use="required"/>
    <xs:attribute name="status"
                  type="logMessageRRT"
                  use="required"/>
  </xs:complexType>


  <!-- ************************* -->
  <!-- ************************* -->


  <xs:complexType name="logMessageT">
    <xs:annotation >
      <xs:documentation >
        This type provides a representation of a
        complete log message entry. Each entry has
        a status code, a log ID, and the log data.
        Log data is application-defined. Client
        applications are responsible for properly encoding
        the log data per standard XML rules, including
        character quoting, properly formatted fragments,
        etc.
      </xs:documentation>
    </xs:annotation>
    <xs:simpleContent >
      <xs:extension base="logMessageDataT">
        <xs:attribute name="logEntryID"
                      type="logMessageIDT"
                      use="required"/>
        <xs:attribute name="severity"
                      type="logEntrySeverityCodeT"
                      use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>


