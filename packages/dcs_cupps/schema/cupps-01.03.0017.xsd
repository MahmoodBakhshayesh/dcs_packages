            Status of sub-device PR, if present.
          </xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="desc"
                  type="statusDescT"
                  use="optional">
    </xs:attribute>
    <xs:attribute name="init"
                  type="xs:boolean"
                  use="required">
      <xs:annotation>
        <xs:documentation>
          Is the device initializing.
        </xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="powerOff"
                  type="xs:boolean"
                  use="required">
