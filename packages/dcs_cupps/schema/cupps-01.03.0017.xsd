  <xs:complexType name="authenticateRequestT">
    <xs:annotation >
      <xs:documentation >
        Client authentication request.
        The parameters are used both for
        authentication and for reporting
        device lock situations.
      </xs:documentation>
    </xs:annotation>
    <xs:sequence minOccurs="1"
                 maxOccurs="1">
